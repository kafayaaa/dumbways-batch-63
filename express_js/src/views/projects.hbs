<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="../assets/style/style.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </head>
  <body
    class="container vh-100 d-flex flex-column justity-content-center align-items-center p-5"
  >
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-nav fixed-top">
      <div class="container">
        <a class="navbar-brand" href="#">
          <img
            src="https://dumbways.id/assets/images/brandred.png"
            alt="logo"
            height="40"
          />
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" aria-current="page" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active fw-bold" href="#">My Project</a>
            </li>
          </ul>

          <span class="fw-bold me-3">{{userData.username}}</span>

          <a href="/contact" class="btn fw-bold bg-black text-light me-3">
            Contact Me
          </a>
          <a href="/logout" class="btn fw-bold bg-danger text-light">
            LOGOUT
          </a>
        </div>
      </div>
    </nav>
    <!-- End Navbar -->

    <h1 class="py-5 fw-bold">ADD MY PROJECT</h1>

    <!-- Form -->
    <form class="mb-5" id="userForm">
      <input type="hidden" id="id" name="id" />
      <div class="mb-3">
        <label for="name" class="form-label fw-bold">Project Name</label>
        <input
          type="text"
          class="form-control shadow"
          id="name"
          name="name"
          aria-describedby="nameHelp"
          required
        />
      </div>
      <div class="d-flex justify-content-between align-items-center gap-3">
        <div class="mb-3 w-100">
          <label for="startDate" class="form-label fw-bold">Start Date</label>
          <input
            type="date"
            class="form-control shadow"
            id="startDate"
            name="startDate"
            aria-describedby="nameHelp"
            required
          />
        </div>
        <div class="mb-3 w-100">
          <label for="endDate" class="form-label fw-bold">End Date</label>
          <input
            type="date"
            class="form-control shadow"
            id="endDate"
            name="endDate"
            aria-describedby="nameHelp"
            required
          />
        </div>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label fw-bold">Description</label>
        <textarea
          class="form-control shadow"
          id="description"
          name="description"
          rows="5"
          required
        ></textarea>
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Technologies</label>
        <div class="d-flex justify-content-start align-items-center gap-5">
          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              name="technology"
              value="node-js"
              id="technology1"
            />
            <label class="form-check-label" for="technology1"> Node JS </label>
          </div>
          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              name="technology"
              value="java"
              id="technology2"
            />
            <label class="form-check-label" for="technology2"> Java </label>
          </div>
        </div>
        <div class="d-flex justify-content-start align-items-center gap-5">
          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              name="technology"
              value="react"
              id="technology3"
            />
            <label class="form-check-label" for="technology3"> React JS </label>
          </div>
          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              name="technology"
              value="android"
              id="technology4"
            />
            <label class="form-check-label" for="technology4">Android</label>
          </div>
        </div>
      </div>
      <div class="mb-3">
        <label for="file" class="form-label fw-bold">Upload File</label>
        <input
          class="form-control"
          type="file"
          id="image"
          name="image"
          accept="image/*"
        />
      </div>
      <div class="d-flex justify-content-end mt-5 gap-3">
        {{! <button
          type="button"
          class="btn bg-danger text-light fw-bold rounded-5 px-4 py-2"
          id="cancelBtn"
          class="btn btn-secondary"
          onclick="cancelEdit()"
          style="display: none"
        >
          Cancel
        </button> }}
        <button
          type="submit"
          class="btn bg-black text-light fw-bold rounded-5 px-4 py-2"
          id="saveBtn"
        >
          Add
        </button>
      </div>
    </form>
    <!-- End Form -->

    <!-- Showcase -->
    <div
      class="bg-white p-5 showcase d-flex flex-column justify-content-center align-items-center"
    >
      <h1 class="fw-bold mb-5">MY PROJECT</h1>
      <div class="container">
        <!-- Cards -->
        <div
          class="d-flex justify-content-start align-items-stretch flex-wrap gap-5"
          id="cards"
        ></div>
        <!-- End Cards -->
      </div>
    </div>
    <!-- End Showcase -->
    <script src="../assets/script/projects.js"></script>
  </body>
</html>